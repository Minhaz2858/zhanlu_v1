  {
   "id": "n10",
   "type": "llm",
   "position": {
    "x": 1240,
    "y": 300
   },
   "data": {
    "label": "CEO Synthesis",
    "config": {
     "prompt": "You are the CEO's chief of staff. Merge the specialist answers into one executive reply. Sections (only the branch that ran is populated): [Customers] {{inputs.n4.text}} [ERP] {{inputs.n5.text}} [Research] {{inputs.n6.text}} [Reports] {{inputs.n8.text}} [General] {{inputs.n9.text}}. Write a concise markdown executive answer: 1) one-line verdict, 2) key numbers with units (use ¥ for CNY), 3) recommended action. Ground every number in the sections. Do not invent figures."
    }
   }
  },
  {
   "id": "n11",
   "type": "output",
   "position": {
    "x": 1500,
    "y": 300
   },
   "data": {
    "label": "CEO Answer",
    "config": {
     "format": "markdown"
    }
   }
  },
  {
   "id": "n12",
   "type": "db_query",
   "position": {
    "x": 980,
    "y": 380
   },
   "data": {
    "label": "Weekly Sales Query",
    "config": {
     "kb_id": "b1b9145d-5b6b-4c0e-ba82-919dde4620d7",
     "mode": "sql",
     "sql": "SELECT DATE_FORMAT(PLANDATE, '%x-W%v') AS week, COUNT(DISTINCT FID) AS orders, COUNT(DISTINCT FCUSTID) AS customers, ROUND(SUM(FQTY_ORIGIN), 2) AS qty, ROUND(SUM(FALLAMOUNT), 2) AS amount FROM v_sale_order WHERE PLANDATE >= DATE_SUB(CURDATE(), INTERVAL 8 WEEK) GROUP BY week ORDER BY week DESC",
     "question": "{{inputs.n1.text}}",
     "limit": 20
    }
   }
  }
