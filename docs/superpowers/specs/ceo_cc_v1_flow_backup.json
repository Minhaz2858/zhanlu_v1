   "data": {
    "label": "CEO Orchestrator",
    "config": {
     "prompt": "You are the CEO orchestrator. Classify the CEO's question into exactly one category and reply with ONLY the category name: CUSTOMERS (customer inquiries, support, accounts), ERP (sales, finance, orders, revenue, margins), RESEARCH (market research, industry analysis), REPORTS (generate a report), GENERAL (anything else). Question: {{inputs.n1.text}}"
    }
   }
  },
  {
   "id": "n3",
   "type": "switch",
   "position": {
    "x": 480,
    "y": 300
   },
   "data": {
    "label": "Route by Domain 1",
    "config": {
     "cases": [
      {
       "field": "{{inputs.n2.text}}",
       "op": "contains",
       "value": "CUSTOMERS"
      },
      {
       "field": "{{inputs.n2.text}}",
