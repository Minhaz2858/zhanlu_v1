  {
   "id": "n5",
   "type": "db_query",
   "position": {
    "x": 740,
    "y": 240
   },
   "data": {
    "label": "ERP KPI Snapshot",
    "config": {
     "kb_id": "b1b9145d-5b6b-4c0e-ba82-919dde4620d7",
     "mode": "sql",
     "sql": "SELECT (SELECT COUNT(DISTINCT FID) FROM v_sale_order) AS total_orders, (SELECT COUNT(DISTINCT FCUSTID) FROM v_sale_order) AS total_customers, (SELECT COUNT(DISTINCT material_code) FROM v_sale_order) AS total_materials, (SELECT COALESCE(ROUND(SUM(FQTY_ORIGIN),2),0) FROM v_sale_order) AS total_qty, (SELECT COALESCE(ROUND(SUM(FALLAMOUNT),2),0) FROM v_sale_order) AS total_amount, (SELECT org_name FROM (SELECT org_name, SUM(FALLAMOUNT) AS amt FROM v_sale_order GROUP BY org_name ORDER BY amt DESC LIMIT 1) t) AS top_org",
     "question": "",
     "limit": 20,
     "retryOnFail": 0,
     "continueOnFail": false
    }
   }
  },
