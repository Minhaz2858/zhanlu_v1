# Zhanlu — gitignore

# Environment secrets
.env

# MinIO local data
infra/minio/data/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtualenvs — host-side only. The container installs requirements.txt at
# build time and must never see /app/venv (stale-venv hijack scar, see .env).
backend/venv/
backend/venv.*/
.venv/

# SQLite databases
*.db
*.sqlite

# Agent workspaces
agent_workspace/
ohmo/
.worktrees/

# Uploads
uploads/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node
node_modules

# Frontend build output — only frontend/dist is served by the nginx container
frontend/dist-new/
frontend/dist_old/
frontend/dist.*/
frontend/reload*.yaml
frontend/snap*.yaml

# Build / installer / snapshot junk (never source)
*.dmg
/*.zip
.git.corrupt/
logs/

# caches / OS junk
.ruff_cache/

# Agent tool state — never source
.codebuddy/
.workbuddy/
.superpowers/
.hermes/

# QA archive + generated deliverables (artifacts, not source)
agent_qa/
outputs/
backend/data/
