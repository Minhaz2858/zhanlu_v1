  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 16,
    "full": 9999
  },
  "shadows": {
    "sm": "0 1px 2px rgba(0,0,0,0.05)",
    "md": "0 4px 6px rgba(0,0,0,0.07)",
    "lg": "0 10px 15px rgba(0,0,0,0.1)"
  },
  "source_palette": {
    "origin": "anthropics/theme-factory",
    "colors": [
      {
        "name": "Electric Blue",
        "hex": "#0066ff"
      },
      {
        "name": "Neon Cyan",
        "hex": "#00ffff"
      },
      {
        "name": "Dark Gray",
        "hex": "#1e1e1e"
      },
      {
        "name": "White",
        "hex": "#ffffff"
      }
    ]
