{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Theme System Output",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "partial", "failed"]
    },
    "artifact_type": {
      "type": "string"
    },
    "theme_name": {
      "type": "string",
      "description": "The theme that was applied (preset name or custom name)"
    },
    "mode": {
      "type": "string",
      "enum": ["light", "dark"]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "size_bytes": { "type": "integer" }
        },
        "required": ["path"]
      }
    },
    "build_manifest": {
      "type": "object",
      "properties": {
        "theme_applied": { "type": "string" },
        "tokens_resolved": { "type": "integer" },
        "colors_replaced": { "type": "integer" },
        "fonts_replaced": { "type": "integer" }
      }
    },
    "validation_report": {
      "type": "object",
      "properties": {
        "contrast_checks": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "wcag_level": { "type": "string" },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "foreground": { "type": "string" },
              "background": { "type": "string" },
              "ratio": { "type": "number" },
              "required": { "type": "number" },
              "context": { "type": "string" }
            }
          }
        }
      }
    },
    "error": {
      "type": "string",
      "description": "Error message if status is failed"
    }
  },
  "required": ["status"]
}
