# ===== Database =====
# REQUIRED. The app refuses to start without this. The previous "silent SQLite
# default" caused real confusion (a leftover empty zhanlu.db file looked like
# the real database while the actual data lived in Postgres). Pick ONE:
#
#   PostgreSQL (recommended — this is what docker-compose spins up):
DATABASE_URL=postgresql+psycopg2://zhanlu:zhanlu123@postgres:5432/zhanlu
#
#   SQLite (only for single-user offline dev — you'll need to run
#   `alembic upgrade head` against the file yourself):
# DATABASE_URL=sqlite:///./zhanlu.db
#
# After changing this, verify with:
#   python -m scripts.check_db
#   curl http://localhost:5002/api/_db-info

# ===== EDIA Market Dashboard (read-only MySQL mirror) =====
# Empty = dashboard routes return 503. Fill with the EDIA warehouse DSN
# to enable the /api/market-dashboard/* endpoints.
# EDIA_MYSQL_URL=mysql+pymysql://root:PASSWORD@10.10.10.49:3306/aipdp_data_warehouse_prod

# ===== Auth =====
# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
# Token lifecycle & password policy (plan 2026-07-27)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_LETTER=true
PASSWORD_REQUIRE_DIGIT=true
# Rate limits (in-memory, per IP; 0 = disabled)
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_10MIN=3
RATE_LIMIT_OTP_PER_10MIN=3
RATE_LIMIT_RESET_PER_10MIN=3

# ===== App =====
# The appId used by the frontend (any value works, backend accepts all)
APP_ID=local-zhanlu-app
# Frontend dev server URL (for logout redirect)
FRONTEND_URL=http://localhost:5173
# Backend port
BACKEND_PORT=5002

# ===== File Uploads =====
UPLOAD_DIR=uploads

# ===== LLM (for future InvokeLLM implementation — Phase 2+) =====
OPENAI_API_KEY=sk-8d6b43e1c09546efb31eb03dff61d5c3
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash