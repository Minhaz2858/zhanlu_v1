# ===== Database =====
# REQUIRED. The app refuses to start without this. The previous "silent SQLite
# default" caused real confusion (a leftover empty zhanlu.db file looked like
# the real database while the actual data lived in Postgres). Pick ONE:
#
#   PostgreSQL (recommended — this is what docker-compose spins up):
DATABASE_URL=postgresql+psycopg2://zhanlu:zhanlu123@postgres:5432/zhanlu
#
#   SQLite (only for single-user offline dev — you'll need to run
#   `alembic upgrade head` against the file yourself):
# DATABASE_URL=sqlite:///./zhanlu.db
#
# After changing this, verify with:
#   python -m scripts.check_db
#   curl http://localhost:5002/api/_db-info

# ===== External MySQL warehouse (optional read-only mirror) =====
# Empty = warehouse-backed loaders/dashboards return empty/503. Fill with an
# enterprise ERP mirror DSN to enable those endpoints.
# MYSQL_URL=mysql+pymysql://user:pass@host:3306/dbname
# Per-product Supply Chain Snapshot panel (ERP grade KPIs). Default false
# (endpoint returns an empty GradeKpiData). Set true to enable
# GET /api/market-dashboard/supply-chain/{product_id}.
SUPPLY_CHAIN_SNAPSHOT_ENABLED=false

# ===== Auth =====
# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24
# Token lifecycle & password policy (plan 2026-07-27)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_LETTER=true
PASSWORD_REQUIRE_DIGIT=true
# Rate limits (in-memory, per IP; 0 = disabled)
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_10MIN=3
RATE_LIMIT_OTP_PER_10MIN=3
RATE_LIMIT_RESET_PER_10MIN=3

# ===== App =====
# The appId used by the frontend (any value works, backend accepts all)
APP_ID=local-zhanlu-app
# Frontend dev server URL (for logout redirect)
FRONTEND_URL=http://localhost:5173
# Backend port
BACKEND_PORT=5002

# ===== File Uploads =====
UPLOAD_DIR=uploads

# ===== Document ingestion — audio / image (2026-08-14) =====
# Audio transcription via OPENAI_BASE_URL/audio/transcriptions (Whisper).
# NOTE: a plain DeepSeek BASE_URL has no Whisper endpoint — uploads degrade
# to an "[Audio attached: ...]" marker. Flip BASE_URL to a Whisper-capable
# host to enable real transcription.
AUDIO_TRANSCRIBE_ENABLED=false
WHISPER_MODEL=whisper-1
WHISPER_TIMEOUT_S=60.0
# Image OCR via Tesseract (requires pytesseract + tesseract binary in the
# container). Without it, images still emit an "[Image attached: ...]" marker
# and are forwarded to the multimodal/vision path.
IMAGE_OCR_ENABLED=false

# ===== PPT Generation Pipeline (Phase 1 — deck quality) =====
# All four stages are OFF by default in the repo. They are enabled ONLY in
# local deployment configs (.env), never committed here.
#   - DECK_PLANNER: build an assertion-driven DeckPlan from user intent + rows
#   - SMART_ROUTER: route the plan to a layout recipe per slide
#   - LLM_POLISH:   one-shot copy polish (headline assertion rewrite) post-render
#   - AUDIT:        audit + repair (overflow / density / assertion-headline) loop
PPT_DECK_PLANNER_ENABLED=false
PPT_SMART_ROUTER_ENABLED=false
PPT_LLM_POLISH_ENABLED=false
PPT_AUDIT_ENABLED=false
# Unlike the four stage toggles above, these two default TRUE in config.py:
# design is the default routing target for pptx requests (deck_router) and a
# failed semantic audit blocks delivery. Set false to restore legacy behavior.
PPT_DESIGN_BY_DEFAULT=true
PPT_AUDIT_BLOCKING_ENABLED=true
# New (deck pipeline v2): route create_artifact(type="pptx") through the
# professional deck pipeline (planner → router → layout engine → audit/repair/
# polish) so the in-chat artifact matches the download. Precondition:
# PPT_DECK_PLANNER_ENABLED. Off by default.
PPT_CREATE_ARTIFACT_PIPELINE_ENABLED=false
# New (deck pipeline v2): ground deck data in the REAL query rows (Execution
# ObservationRecords + conversation tool results) instead of only the
# LLM-authored payload chart data. Used by both the download path and the tool
# path. Off by default.
PPT_DECK_DATA_GROUNDING_ENABLED=false
# Six deterministic deck-edit tools (edit_slide / add_slide / restyle_deck /
# update_chart / remove_slide / reorder_slide). Off by default — when enabled,
# "edit slide 2 ..." style messages route to the edit tools instead of a full
# regeneration.
DECK_EDIT_ROUTING_ENABLED=false
# PPT turn-guard: enforce that a requested PPT deck is actually produced
# (synthesis-boundary nudge + T-3 budget forcing toward create_artifact).
# Off by default.
PPT_TURN_GUARD_ENABLED=false

# ===== Schema Graph + Multi-Table Auto-Join (all agents) =====
# Generic multi-table auto-join for ANY db-bound agent (any database/schema/
# domain — zero hardcoded table or column names). Enabling the chain below
# gives db-bound agents: (1) a SchemaGraph with join edges rendered through
# describe_schema, (2) a schema-aware protocol block in the system prompt
# (auto-join on FK/value-overlap edges >= AUTOJOIN_THRESHOLD, ask otherwise),
# (3) a dynamic per-turn iteration budget scaled to join complexity, and
# (4) sqlglot structural SQL validation with self-correction.
#
# Recommended enable order (all required for the full chain):
#   SEMANTIC_CATALOG_ENABLED=true   # background table/column index per KB
#   SCHEMA_LINKING_ENABLED=true     # query-time table selection (RRF)
#   CATALOG_JOIN_EDGES_ENABLED=true # infer VALUE_OVERLAP / NAME_MATCH edges
#   SCHEMA_GRAPH_ENABLED=true       # render graph + protocol + dynamic budget
#   SCHEMA_GRAPH_SQL_VALIDATOR_ENABLED=true  # optional SQL structural checks
SEMANTIC_CATALOG_ENABLED=false
SCHEMA_LINKING_ENABLED=false
CATALOG_JOIN_EDGES_ENABLED=false
SCHEMA_GRAPH_ENABLED=false
SCHEMA_GRAPH_SQL_VALIDATOR_ENABLED=false
SCHEMA_VALIDATOR_DID_YOU_MEAN_ENABLED=false  # "did you mean" + FK-master hints on validator reject
# Tunables (defaults shown):
SCHEMA_GRAPH_AUTOJOIN_THRESHOLD=0.8
SCHEMA_GRAPH_SAMPLE_ROWS=3
SCHEMA_GRAPH_TOKEN_BUDGET=1200
JOIN_EDGE_SAMPLE_LIMIT=200

# ===== LLM (for future InvokeLLM implementation — Phase 2+) =====
OPENAI_API_KEY=sk-8d6b43e1c09546efb31eb03dff61d5c3
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
# ===== Universal Self-Evaluation & Re-Planning Loop (all agents) =====
# When enabled, EVERY agent verifies its draft answer at the synthesis
# boundary (deterministic detectors + one optional LLM strict-inspector call)
# and re-plans up to SELF_EVAL_MAX_REPLANS times before answering with a gap
# disclosure. Works identically across all data sources (SQL, RAG, files,
# APIs, web). Default OFF — flag-off keeps behavior byte-identical.
SELF_EVAL_REPLAN_ENABLED=false
# Sub-flag: run the single LLM strict-inspector call at the synthesis
# boundary. Set false for deterministic-only verification.
SELF_EVAL_LLM_GATE_ENABLED=true
# Max re-plan nudges per user turn before escalating to a gap disclosure.
SELF_EVAL_MAX_REPLANS=3
# Timeout (s) for the synchronous LLM evaluator call.
SELF_EVAL_LLM_GATE_TIMEOUT_S=15.0

# ===== Live-failure fixes on aipdp_data_warehouse_prod (2026-08-18) =====
# All default OFF — flag-off keeps behavior byte-identical.
# Fix 1a: strict artifact-format match — a mid-turn text report card never
# satisfies an explicit pptx/docx/xlsx/dashboard request (also un-blocks the
# orchestrator dashboard fallback branch).
DOC_REQUEST_STRICT_ARTIFACT_MATCH_ENABLED=false
# Fix 1b: PPT turn-guard nudge cap (number of allowed prose nudges before the
# final nudge becomes a HARD create_artifact tool-force).
PPTX_NUDGE_MAX=2
# Fix 2: answer plausibility gate — deterministic part>whole (×1.02) and
# cross-call same-scope total-drift (>10%) detectors feeding the retry/disclose path.
ANSWER_PLAUSIBILITY_CHECK_ENABLED=false
# Fix 3: NL2SQL fan-out guard — measure-SUM joins without pre-aggregation emit a
# validator warning that triggers one self-correct retry.
NL2SQL_FANOUT_GUARD_ENABLED=false
# Fix 5: typo-tolerant dashboard intent — consonant-skeleton fuzzy match
# ("Dashbord"/"dahsboard") across all four dashboard detectors.
DASHBOARD_FUZZY_MATCH_ENABLED=false
# Fix 6: dashboard-narration nudge guard — narration-only exits on dashboard
# turns inject a hard nudge naming the exact next workflow step (design →
# schema → build), capped at MAX_DASHBOARD_NARRATION_NUDGES per turn.
# Off by default — flag-off keeps behavior byte-identical.
DASHBOARD_NARRATION_NUDGE_ENABLED=false
MAX_DASHBOARD_NARRATION_NUDGES=1

# ===== Goal Contract (shared agent loop) =====
# A machine-checkable Goal Contract is built once per turn and checked before
# ANY loop exit: unmet goals force remediation (artifact tool, re-query with
# actual distinct values, announced tool), bounded by GOAL_CONTRACT_MAX_FORCES.
# Off by default — flag-off keeps behavior byte-identical.
GOAL_CONTRACT_ENABLED=false
GOAL_CONTRACT_MAX_FORCES=3

# ===== Entity Master Filter (all db-bound agents) =====
# Master gate: when True, agents discover the entity_master table, filter it to
# the requested entity IDs, then query fact tables with WHERE <id> IN (...).
# Prevents multi-thousand-record unfiltered dumps.
ENTITY_MASTER_FILTER_ENABLED=false
# Sub-flag: auto-classify tables as entity_master/fact/bridge/dimension/unknown
# during catalog indexing (structural heuristics only, zero hardcoded names).
# Backfill roles by re-running the catalog indexer after enabling.
TABLE_ROLE_AUTO_CLASSIFY_ENABLED=false
# Row-count ceiling used by the classifier when deciding entity_master.
ENTITY_MASTER_MAX_ROW_COUNT=50000

# ===== Email Notification Gateway (automation run result emails) =====
# Master switch. When false the gateway skips every run regardless of per-task
# settings. Enable globally FIRST, then add recipient emails on each task.
NOTIFICATION_GATEWAY_ENABLED=false
# Largest file (bytes) that can be attached to the email body. Larger files
# (or tasks with attach_file=false) are sent as a 7-day HMAC download link.
EMAIL_ATTACH_MAX_BYTES=8388608
# Lifetime of the HMAC-signed download link, in days.
EMAIL_DOWNLOAD_LINK_TTL_DAYS=7
# SMTP transport retries (exponential backoff 1s/2s/4s). Permanent errors such
# as invalid recipient addresses fail fast and never retry.
EMAIL_MAX_RETRIES=3
# SMTP server used by BOTH the OTP mailer and the notification gateway.
# When SMTP_HOST is empty the backend falls back to logging OTPs to the console.
# Use port 465 with SMTP_USE_SSL=true (SSL), or 587 with false (STARTTLS).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=            # defaults to SMTP_USER
SMTP_USE_SSL=true
SMTP_FROM_NAME=Zhanlu System
