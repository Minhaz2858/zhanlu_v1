{
  "name": "modern-minimalist",
  "description": "A clean and contemporary theme with a sophisticated grayscale palette for maximum versatility.",
  "best_for": [
    "Tech presentations",
    "Architecture portfolios",
    "Design showcases",
    "Data visualization"
  ],
  "colors": {
    "light": {
      "primary": "#36454f",
      "secondary": "#708090",
      "surface": "#f1f5f9",
      "background": "#ffffff",
      "text": "#1e293b",
      "text_muted": "#545862",
      "border": "#cbd5e1",
      "success": "#16a34a",
      "warning": "#d97706",
      "error": "#dc2626",
      "info": "#0ea5e9"
    },
    "dark": {
      "primary": "#94a3b8",
      "secondary": "#708090",
      "surface": "#1e293b",
      "background": "#0f172a",
      "text": "#f1f5f9",
      "text_muted": "#94a3b8",
      "border": "#334155",
      "success": "#22c55e",
      "warning": "#fbbf24",
      "error": "#ef4444",
      "info": "#38bdf8"
    }
  },
  "fonts": {
    "heading": "Inter",
    "body": "Inter",
    "mono": "JetBrains Mono"
  },
  "typography": {
    "heading_scale": [
      2.5,
      2.0,
      1.5,
      1.25,
      1.0
    ],
    "body_size": "16px",
    "line_height": "1.6"
  },
  "spacing": {
    "unit": 4,
    "scale": [
      0,
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64
    ]
  },
  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 16,
    "full": 9999
  },
  "shadows": {
    "sm": "0 1px 2px rgba(0,0,0,0.05)",
    "md": "0 4px 6px rgba(0,0,0,0.07)",
    "lg": "0 10px 15px rgba(0,0,0,0.1)"
  },
  "source_palette": {
    "origin": "anthropics/theme-factory",
    "colors": [
      {
        "name": "Charcoal",
        "hex": "#36454f"
      },
      {
        "name": "Slate Gray",
        "hex": "#708090"
      },
      {
        "name": "Light Gray",
        "hex": "#d3d3d3"
      },
      {
        "name": "White",
        "hex": "#ffffff"
      }
    ]
  }
}
