{
  "name": "zhanlu-blue",
  "description": "Zhanlu's default brand theme — a confident corporate blue on white. Reproduces the legacy branded deck exactly.",
  "best_for": [
    "Default reports",
    "General business decks",
    "Internal analytics"
  ],
  "colors": {
    "light": {
      "primary": "#2563eb",
      "secondary": "#1d4ed8",
      "surface": "#f1f5f9",
      "background": "#ffffff",
      "text": "#0f172a",
      "text_muted": "#64748b",
      "border": "#e2e8f0",
      "success": "#059669",
      "warning": "#f59e0b",
      "error": "#dc2626",
      "info": "#0ea5e9"
    },
    "dark": {
      "primary": "#60a5fa",
      "secondary": "#93c5fd",
      "surface": "#1e293b",
      "background": "#0f172a",
      "text": "#f8fafc",
      "text_muted": "#94a3b8",
      "border": "#334155",
      "success": "#22c55e",
      "warning": "#fbbf24",
      "error": "#ef4444",
      "info": "#38bdf8"
    }
  },
  "fonts": {
    "heading": "Inter",
    "body": "Inter",
    "mono": "JetBrains Mono"
  },
  "typography": {
    "heading_scale": [2.5, 2.0, 1.5, 1.25, 1.0],
    "body_size": "16px",
    "line_height": "1.6"
  },
  "spacing": {
    "unit": 4,
    "scale": [0, 4, 8, 12, 16, 24, 32, 48, 64]
  },
  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 16,
    "full": 9999
  },
  "shadows": {
    "sm": "0 1px 2px rgba(0,0,0,0.05)",
    "md": "0 4px 6px rgba(0,0,0,0.07)",
    "lg": "0 10px 15px rgba(0,0,0,0.1)"
  },
  "deck": {
    "primary_dark": "#1d4ed8",
    "band_bg": "#f8fafc",
    "kpi_bg": "#f1f5f9",
    "insight_bg": "#eff6ff",
    "next_bg": "#eff6ff",
    "rec_bg": "#eff6ff",
    "finding_bg": "#f5f3ff",
    "finding_accent": "#7c3aed",
    "warn_bg": "#fffbeb",
    "warn_accent": "#f59e0b",
    "chart_palette": ["#2563eb", "#3b82f6", "#1d4ed8", "#60a5fa", "#93c5fd", "#1e40af"]
  },
  "source_palette": {
    "origin": "zhanlu/brand",
    "colors": [
      {"name": "Blue 600", "hex": "#2563eb"},
      {"name": "Blue 700", "hex": "#1d4ed8"},
      {"name": "Slate 900", "hex": "#0f172a"},
      {"name": "White", "hex": "#ffffff"}
    ]
  }
}
