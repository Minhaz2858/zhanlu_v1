      "muted": "#1A1E2F",
      "border": "#334155",
      "destructive": "#EF4444",
      "ring": "#0F172A",
      "chart_palette": [
        "#22C55E",
        "#EF4444",
        "#FFFFFF",
        "#2563eb",
        "#10b981",
        "#f59e0b"
      ],
      "dark": {
        "background": "#020617",
        "foreground": "#F8FAFC",
        "muted": "#1A1E2F",
        "border": "#334155"
