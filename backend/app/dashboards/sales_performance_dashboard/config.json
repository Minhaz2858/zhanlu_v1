      "foreground": "#0F172A",
      "muted": "#F0F8F6",
      "border": "#E1F2ED",
      "destructive": "#DC2626",
      "ring": "#059669",
      "chart_palette": [
        "#059669",
        "#DC2626",
        "#10B981",
        "#2563eb",
        "#10b981",
        "#f59e0b"
      ],
      "dark": {
        "background": "#020617",
        "foreground": "#f8fafc",
        "muted": "#1e293b",
        "border": "#334155"
      }
    },
    "typography": {
      "heading": "Fira Code",
      "body": "Fira Sans",
      "google_fonts_url": "https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=Fira+Sans:wght@300;400;500;600;700&display=swap",
