# Prebuilt Office sandbox image — for DOCX/XLSX/PDF generation skills
# Based on sandbox-python with LibreOffice for document conversion

FROM zhanlu-sandbox-python:latest

# Fix stale apt lock from parent, then install LibreOffice for document conversion
# ── Re-apply Aliyun mirror (defensive — parent already sets it) ─────────
RUN rm -rf /var/lib/apt/lists 2>/dev/null; rm -rf /var/cache/apt/archives 2>/dev/null; mkdir -p /var/lib/apt/lists/partial /var/cache/apt/archives/partial \
    && sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true \
    && apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-core \
    fonts-dejavu \
    && apt-get clean && rm -rf /var/lib/apt/lists

WORKDIR /output
CMD ["python", "/skill/run.py"]
