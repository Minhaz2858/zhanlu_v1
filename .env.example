# ── Zhanlu Local Dev ──────────────────────────────────────────────────
# Copy this file to .env and adjust for your environment.
# cp .env.example .env

# ── Core ports ────────────────────────────────────────────────────────
BACKEND_PORT=5002
FRONTEND_PORT=5173

# ── Database ──────────────────────────────────────────────────────────
# SQLite (default, no Docker needed):
# DATABASE_URL=sqlite:///./zhanlu.db
#
# PostgreSQL (Docker Compose):
DATABASE_URL=postgresql+psycopg2://zhanlu:change_me@postgres:5432/zhanlu

POSTGRES_DB=zhanlu
POSTGRES_USER=zhanlu
POSTGRES_PASSWORD=change_me

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO (S3-compatible object storage) ──────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=zhanlu-artifacts

# ── Artifact Storage ──────────────────────────────────────────────────
# "postgres_bytea" = store blobs in PostgreSQL (MVP default)
# "minio"         = store blobs in MinIO / S3
ARTIFACT_STORAGE_BACKEND=postgres_bytea
MAX_ARTIFACT_MB=100
PREVIEW_GENERATION_ENABLED=true

# ── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=change_me_long_random_secret_in_production
JWT_EXPIRE_MINUTES=10080

# ── LLM Provider ──────────────────────────────────────────────────────
# Routed through Synexia. Fill in your keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

MODEL_PROVIDER_KEY=

# ── Web Search ────────────────────────────────────────────────────────
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=

# ── Image Generation ──────────────────────────────────────────────────
IMAGE_API_PROVIDER=openai
IMAGE_API_KEY=
IMAGE_MODEL=dall-e-3

# ── Sandbox ───────────────────────────────────────────────────────────
SANDBOX_ENABLED=true
SANDBOX_TMP_ROOT=/tmp/zhanlu_sandbox
SANDBOX_DEFAULT_NETWORK=none
SANDBOX_DEFAULT_TIMEOUT_SECONDS=120
SANDBOX_DEFAULT_MEMORY_MB=1024
SANDBOX_DEFAULT_CPUS=1
SANDBOX_DEFAULT_PIDS_LIMIT=128
SANDBOX_MAX_OUTPUT_MB=100
SANDBOX_CLEANUP_ALWAYS=true
SANDBOX_ALLOW_DOCKER_SOCKET_ONLY_IN_WORKER=true

# Sandbox images (built locally by docker compose)
SANDBOX_IMAGE_PYTHON=zhanlu-sandbox-python:latest
SANDBOX_IMAGE_NODE=zhanlu-sandbox-node:latest
SANDBOX_IMAGE_OFFICE=zhanlu-sandbox-office:latest
SANDBOX_IMAGE_WEBAPP=zhanlu-sandbox-webapp:latest

# ── Synexia FSM ───────────────────────────────────────────────────────
SYNEXIA_FSM_ENABLED=false

# ── File Uploads ──────────────────────────────────────────────────────
UPLOAD_DIR=/app/data/uploads

# ── Forecast MLOps + HITL (all OFF by default; enable in rollout order) ──
FORECAST_EVAL_JOB_ENABLED=false
FORECAST_DRIFT_AUTO_ADJUST_ENABLED=false
FORECAST_DRIFT_BLEND_FACTOR=0.2
FORECAST_HITL_ENABLED=false
FORECAST_BIAS_CORRECTION_ENABLED=false
