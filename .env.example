# ── Zhanlu Local Dev ──────────────────────────────────────────────────
# Copy this file to .env and adjust for your environment.
# cp .env.example .env

# ── Core ports ────────────────────────────────────────────────────────
BACKEND_PORT=5002
FRONTEND_PORT=5173

# ── Database ──────────────────────────────────────────────────────────
# SQLite (default, no Docker needed):
# DATABASE_URL=sqlite:///./zhanlu.db
#
# PostgreSQL (Docker Compose):
DATABASE_URL=postgresql+psycopg2://zhanlu:change_me@postgres:5432/zhanlu

POSTGRES_DB=zhanlu
POSTGRES_USER=zhanlu
POSTGRES_PASSWORD=change_me

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO (S3-compatible object storage) ──────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=zhanlu-artifacts

# ── Artifact Storage ──────────────────────────────────────────────────
# "postgres_bytea" = store blobs in PostgreSQL (MVP default)
# "minio"         = store blobs in MinIO / S3
ARTIFACT_STORAGE_BACKEND=postgres_bytea
MAX_ARTIFACT_MB=100
PREVIEW_GENERATION_ENABLED=true

# ── Auth ──────────────────────────────────────────────────────────────
JWT_SECRET=change_me_long_random_secret_in_production
JWT_EXPIRE_MINUTES=10080

# ── LLM Provider ──────────────────────────────────────────────────────
# Routed through Synexia. Fill in your keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

MODEL_PROVIDER_KEY=

# Let the LLM emit multiple tool_calls per assistant message; the agent
# loops execute them in parallel (P0-2). OpenAI-compatible families:
# deepseek*, openai/*, gpt-*, qwen*, moonshot/kimi*, minimax*, glm/zhipu*.
# Anthropic models never receive the field (they reject it). Default: false.
LLM_PARALLEL_TOOL_CALLS_ENABLED=true

# Seed well-known LLM catalog rows (Kimi K2, MiniMax M2, ...) into the
# admin model list on startup. "missing-only" (default) inserts rows only
# when no row with the same model_id exists; "skip" disables. API keys are
# never seeded — attach them per-row in the admin UI or use the global key.
LLM_CATALOG_SEED_MODE=missing-only

# Deep Research Mode (v1): plan → parallel gather (with critique) → cited
# report. Flag off by default; when on, chat turns with research metadata
# run the research protocol instead of the default tool loop.
DEEP_RESEARCH_ENABLED=false
# Hard cap on gather rounds regardless of depth preset.
DEEP_RESEARCH_MAX_ROUNDS=3
# Per-LLM-call timeout inside the research protocol (seconds).
DEEP_RESEARCH_TIMEOUT_S=90

# LLM provider failover — JSON array of {"name","base_url","api_key","model"}
# tried in order when the primary provider fails. Example wiring Kimi K2 +
# MiniMax M2 (fill in real keys; keys are required for a provider to count):
# LLM_FALLBACK_PROVIDERS=[{"name":"kimi","base_url":"https://api.moonshot.cn/v1","api_key":"","model":"kimi-k2"},{"name":"minimax","base_url":"https://api.minimax.io/v1","api_key":"","model":"MiniMax-M2"}]

# ── Web Search ────────────────────────────────────────────────────────
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=

# ── Image Generation ──────────────────────────────────────────────────
IMAGE_API_PROVIDER=openai
IMAGE_API_KEY=
IMAGE_MODEL=dall-e-3

# ── Sandbox ───────────────────────────────────────────────────────────
SANDBOX_ENABLED=true
SANDBOX_TMP_ROOT=/tmp/zhanlu_sandbox
SANDBOX_DEFAULT_NETWORK=none
SANDBOX_DEFAULT_TIMEOUT_SECONDS=120
SANDBOX_DEFAULT_MEMORY_MB=1024
SANDBOX_DEFAULT_CPUS=1
SANDBOX_DEFAULT_PIDS_LIMIT=128
SANDBOX_MAX_OUTPUT_MB=100
SANDBOX_CLEANUP_ALWAYS=true
SANDBOX_ALLOW_DOCKER_SOCKET_ONLY_IN_WORKER=true

# Sandbox images (built locally by docker compose)
SANDBOX_IMAGE_PYTHON=zhanlu-sandbox-python:latest
SANDBOX_IMAGE_NODE=zhanlu-sandbox-node:latest
SANDBOX_IMAGE_OFFICE=zhanlu-sandbox-office:latest
SANDBOX_IMAGE_WEBAPP=zhanlu-sandbox-webapp:latest

# ── Synexia FSM ───────────────────────────────────────────────────────
SYNEXIA_FSM_ENABLED=false

# ── Swarm fan-out pool ────────────────────────────────────────────────
# Bounded parallel executor for swarm_orchestrate. Budgets gate NEW
# spawns only; skipped tasks are reported as failed results.
SWARM_MAX_CONCURRENT=8        # max simultaneous workers (0 = unlimited)
SWARM_MAX_COST_USD=0          # cost cap per orchestration (0 = unlimited)
SWARM_MAX_WALL_S=900          # wall-clock cap per orchestration (0 = unlimited)

# ── File Uploads ──────────────────────────────────────────────────────
UPLOAD_DIR=/app/data/uploads

# ── Forecast MLOps + HITL (all OFF by default; enable in rollout order) ──
FORECAST_EVAL_JOB_ENABLED=false
FORECAST_DRIFT_AUTO_ADJUST_ENABLED=false
FORECAST_DRIFT_BLEND_FACTOR=0.2
FORECAST_HITL_ENABLED=false
FORECAST_BIAS_CORRECTION_ENABLED=false

# ── Computer Use (managed-browser facade) ─────────────────────────────
# computer_use tool over the agent-browser CLI. OFF by default — the
# handler returns the legacy "not implemented" stub until enabled.
COMPUTER_USE_ENABLED=false
# Per-conversation action budget; `close` resets it.
COMPUTER_USE_MAX_STEPS=20
# Reserved for a future engine launch config (agent-browser CLI has no
# --viewport flag yet).
COMPUTER_USE_VIEWPORT=1280,800
# Idle session expiry in seconds (one shared Chromium per conversation).
COMPUTER_USE_SESSION_TTL_S=1800
# URL allowlist for computer_use `open` — JSON array of hosts and/or URL
# prefixes (e.g. ["example.com", "https://docs.example.com/a"]).
# Empty = SSRF guard only.
COMPUTER_USE_ALLOWED_URLS=[]

# ── SSO / OIDC ─────────────────────────────────────────────────────────
# OFF by default — local email/password login is unaffected (SSO is
# additive account linking).
SSO_ENABLED=false
# JSON array of OIDC providers:
#   [{"id": "google", "name": "Google", "client_id": "...",
#     "client_secret": "...", "issuer": "https://accounts.google.com",
#     "discovery_url": "", "scopes": "openid email profile"}]
SSO_PROVIDERS=[]
# Optional email-domain allowlist (host or subdomain match; empty = allow all).
SSO_ALLOWED_EMAIL_DOMAINS=[]
# OIDC authorize-state TTL (seconds). In-memory store — single-process.
SSO_STATE_TTL_S=600
